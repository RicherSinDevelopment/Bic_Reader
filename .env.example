EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-publishable-key

# Google Cloud OAuth client IDs. These are public identifiers, not client secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=545678162563-0k2ll0n8dce2ubm8m787idnml9d39i8d.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Optional legal links shown on the onboarding paywall.
# EXPO_PUBLIC_TERMS_URL=
# EXPO_PUBLIC_PRIVACY_URL=

# Public Sentry client endpoint. SENTRY_AUTH_TOKEN must be stored only as a
# sensitive EAS environment variable and must never use the EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id
# EXPO_PUBLIC_APP_ENV=production
