+- (void)setNativeHighlight:(NSInteger)page
+                      left:(CGFloat)left
+                       top:(CGFloat)top
+                     right:(CGFloat)right
+                    bottom:(CGFloat)bottom
+{
+    [self clearNativeHighlight];
+    if (!_pdfDocument || page < 1 || page > (NSInteger)_pdfDocument.pageCount) {
+        RLog(@"switch highlight rejected: document=%@ page=%ld pageCount=%lu",
+             _pdfDocument ? @"loaded" : @"missing",
+             (long)page,
+             (unsigned long)_pdfDocument.pageCount);
+        return;
+    }
+
+    PDFPage *pdfPage = [_pdfDocument pageAtIndex:page - 1];
+    CGRect crop = [pdfPage boundsForBox:kPDFDisplayBoxCropBox];
+    CGRect wordRect = CGRectMake(
+        CGRectGetMinX(crop) + left,
+        CGRectGetMinY(crop) + CGRectGetHeight(crop) - bottom,
+        MAX(1.0, right - left),
+        MAX(1.0, bottom - top)
+    );
+    PDFSelection *selection = [pdfPage selectionForRect:CGRectInset(wordRect, -2.0, -2.0)];
+    if (selection.string.length == 0) {
+        selection = [pdfPage selectionForWordAtPoint:CGPointMake(
+            CGRectGetMidX(wordRect), CGRectGetMidY(wordRect)
+        )];
+    }
+    if (selection.string.length == 0) {
+        RLog(@"switch highlight rejected: no PDFKit text at page=%ld rect=%@",
+             (long)page, NSStringFromCGRect(wordRect));
+        return;
+    }
+
+    selection.color = [[UIColor systemYellowColor] colorWithAlphaComponent:0.58];
+    _switchHighlightSelection = selection;
+    _pdfView.highlightedSelections = @[selection];
+    CGRect selectionRect = [selection boundsForPage:pdfPage];
+    [_pdfView goToRect:CGRectInset(selectionRect, -8.0, -24.0) onPage:pdfPage];
+    [_pdfView setNeedsDisplay];
+    RLog(@"switch highlight applied: page=%ld text=%@ rect=%@",
+         (long)page,
+         selection.string,
+         NSStringFromCGRect(selectionRect));
+}
+
+- (void)clearNativeHighlight
+{
+    if (_switchHighlightSelection) {
+        _pdfView.highlightedSelections = nil;
+        _switchHighlightSelection = nil;
+        [_pdfView setNeedsDisplay];
+    }
+}
+
 #endif
 
